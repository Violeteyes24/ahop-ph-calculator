generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["payroll"]
}

enum SalaryType {
  DAILY
  MONTHLY

  @@schema("payroll")
}

enum SalaryCategory {
  AHOP
  NON_AHOP

  @@schema("payroll")
}

enum PaymentMethod {
  CASH
  BANK

  @@schema("payroll")
}

enum EmploymentStage {
  PROBATIONARY
  REGULAR

  @@schema("payroll")
}

enum UserRole {
  ADMIN
  EMPLOYEE

  @@schema("payroll")
}

enum PayrollPeriodStatus {
  DRAFT
  COMPLETED
  ARCHIVED

  @@schema("payroll")
}

enum PayrollImportStatus {
  PARSED
  PERSISTED
  FAILED

  @@schema("payroll")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  employeeId   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee EmployeeProfile? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@schema("payroll")
}

model EmployeeProfile {
  id                       String            @id @default(cuid())
  fullName                 String
  position                 String?
  dateStarted              DateTime
  salaryType               SalaryType
  salaryCategory           SalaryCategory    @default(AHOP)
  dailyRate                Decimal?
  monthlyRate              Decimal?
  employmentStage          EmploymentStage   @default(PROBATIONARY)
  paymentMethod            PaymentMethod     @default(BANK)
  regionCode               String            @default("NCR")
  taxable                  Boolean           @default(false)
  deminimisAmount          Decimal           @default(0)
  isActive                 Boolean           @default(true)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  payrollSnapshots  PayrollSnapshot[]
  attendanceEntries AttendanceEntry[]
  user              User?

  @@schema("payroll")
}

model PayrollPeriod {
  id           String              @id @default(cuid())
  label        String
  periodStart  DateTime
  periodEnd    DateTime
  status       PayrollPeriodStatus @default(DRAFT)
  baselineDays Int                 @default(23)
  createdBy    String
  processedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  attendanceEntries AttendanceEntry[]
  snapshots         PayrollSnapshot[]
  importBatches     PayrollImportBatch[]

  @@schema("payroll")
}

model AttendanceEntry {
  id                    String   @id @default(cuid())
  periodId              String
  employeeId            String
  workingDays           Int      @default(0)
  workedHours           Decimal  @default(0)
  expectedWorkHours     Decimal  @default(0)
  expectedWorkHoursPay  Decimal  @default(0)
  scheduledWorkDays     Decimal  @default(0)
  scheduledWorkDaysPay  Decimal  @default(0)
  overtimeRegularHours  Decimal  @default(0)
  overtimeExtendedHours Decimal  @default(0)
  silDays               Decimal  @default(0)
  slHours               Decimal  @default(0)
  absenceHours          Decimal  @default(0)
  absenceDeduction      Decimal  @default(0)
  tardinessMinutes      Decimal  @default(0)
  tardinessDeduction    Decimal  @default(0)
  aotMinutes            Decimal  @default(0)
  aotPay                Decimal  @default(0)
  extraOtPremium        Decimal  @default(0)
  regularHolidayHours   Decimal  @default(0)
  regularHolidayPay     Decimal  @default(0)
  specialHolidayHours   Decimal  @default(0)
  specialHolidayPay     Decimal  @default(0)
  totalHolidayPay       Decimal  @default(0)
  coAhop                Decimal  @default(0)
  totalAhop             Decimal  @default(0)
  withholdingTax        Decimal  @default(0)
  sourceGrossIncome     Decimal  @default(0)
  loanDeductions        Decimal  @default(0)
  salaryAdjustments     Decimal  @default(0)
  notes                 String?
  calculationError      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  period   PayrollPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([periodId, employeeId])
  @@schema("payroll")
}

model PayrollSnapshot {
  id                    String   @id @default(cuid())
  employeeId            String
  periodId              String?
  periodStart           DateTime
  periodEnd             DateTime
  workingDays           Int
  workedHours           Decimal  @default(0)
  baselineDays          Int      @default(23)
  regularPay            Decimal
  ahopTopup             Decimal
  grossWithAhop         Decimal
  deMinimisPay          Decimal  @default(0)
  sssEmployee           Decimal
  sssEmployer           Decimal  @default(0)
  philHealthEmployee    Decimal
  philHealthEmployer    Decimal  @default(0)
  pagIbigEmployee       Decimal
  pagIbigEmployer       Decimal  @default(0)
  netPay                Decimal
  overtimeRegularHours  Decimal  @default(0)
  overtimeExtendedHours Decimal  @default(0)
  overtimeRegularPay    Decimal  @default(0)
  overtimeExtendedPay   Decimal  @default(0)
  otTotalHours          Decimal  @default(0)
  otTotalPay            Decimal  @default(0)
  silDays               Decimal  @default(0)
  silPay                Decimal  @default(0)
  slHours               Decimal  @default(0)
  slPay                 Decimal  @default(0)
  totalLeaves           Decimal  @default(0)
  totalLeavesPay        Decimal  @default(0)
  absenceHours          Decimal  @default(0)
  absencePay            Decimal  @default(0)
  absenceDeduction      Decimal  @default(0)
  tardinessMinutes      Decimal  @default(0)
  tardinessDeduction    Decimal  @default(0)
  aotMinutes            Decimal  @default(0)
  aotPay                Decimal  @default(0)
  extraOtPremium        Decimal  @default(0)
  regularHolidayHours   Decimal  @default(0)
  regularHolidayPay     Decimal  @default(0)
  specialHolidayHours   Decimal  @default(0)
  specialHolidayPay     Decimal  @default(0)
  totalHolidayPay       Decimal  @default(0)
  coAhop                Decimal  @default(0)
  totalAhop             Decimal  @default(0)
  withholdingTax        Decimal  @default(0)
  loanDeductions        Decimal  @default(0)
  salaryAdjustments     Decimal  @default(0)
  ytdAhop               Decimal  @default(0)
  previousYtdAhop       Decimal  @default(0)
  createdAt             DateTime @default(now())

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period   PayrollPeriod?  @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@unique([periodId, employeeId])
  @@schema("payroll")
}

model ContributionRateConfig {
  id                   String    @id @default(cuid())
  name                 String    @default("Handbook v1")
  philHealthRate       Decimal   @default(2.5)
  pagIbigEmployeeFixed Decimal   @default(100)
  pagIbigEmployerFixed Decimal   @default(100)
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@schema("payroll")
}

model PayrollImportBatch {
  id             String              @id @default(cuid())
  fileName       String
  status         PayrollImportStatus @default(PARSED)
  periodId       String?
  parsedRows     Json
  warnings       Json
  reconciliation Json?
  createdBy      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  period PayrollPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@schema("payroll")
}
